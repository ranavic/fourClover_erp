# fourClover Backend Environment Variables

PORT=5000
JWT_SECRET=fourclover_super_secret_jwt_key_change_me_in_production

# PostgreSQL Database Connection (Option A - Consolidated Render PostgreSQL URL)
DATABASE_URL=postgresql://user:password@dpg-xxxxxx.render.com/fourclover_erp?sslmode=require

# PostgreSQL Database Connection (Option B - Individual parameters)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=fourclover_erp
# DB_SSL=false
